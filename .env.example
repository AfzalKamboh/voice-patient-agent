# --- General ---
APP_ENV=development
# Public HTTPS base URL Twilio can reach (ngrok URL locally, or your deployed
# host in production). No trailing slash.
PUBLIC_BASE_URL=https://your-public-url.ngrok-free.app
LOG_FILE=logs/agent.log

# --- Database ---
# SQLite by default for zero-friction setup. Swap for Postgres in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/patients
DATABASE_URL=sqlite:///./patients.db

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
VALIDATE_TWILIO_SIGNATURE=false

# --- LLM: Ollama Cloud (open-source gpt-oss model) ---
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_MODEL=gpt-oss:20b

# --- TTS: ElevenLabs ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

AUDIO_DIR=static/audio
